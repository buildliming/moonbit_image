}

test "decode_real_qoi_rgba" {
  let img = decode_qoi(make_real_qoi_rgba())
  check_dims(img, 8, 4)
  match img.format {
    PixelFormat::RGBA8 => ()
    _ => raise Failure::Failure("Expected RGBA8 format")
  }
  // Row 0: gradient of R from 0→252 with G=0,B=0
  check_pixel(img, 0, 0, 0, 0, 0, 255)
  check_pixel(img, 7, 0, 252, 0, 0, 255)
  // Row 3: repeating pattern: Red, Green, Blue, White
  check_pixel(img, 0, 3, 255, 0, 0, 255)
  check_pixel(img, 1, 3, 0, 255, 0, 255)
  check_pixel(img, 2, 3, 0, 0, 255, 255)
  check_pixel(img, 3, 3, 255, 255, 255, 255)
  println("Real QOI RGBA test passed!")
}

