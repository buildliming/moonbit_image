}

test "decode_real_png_rgb_sub" {
  let img = decode_png(make_real_png_rgb_sub())
  check_dims(img, 6, 4)
  match img.format {
    PixelFormat::RGB8 => ()
    _ => raise Failure::Failure("Expected RGB8 format")
  }
  // Verify non-trivial pixels from Sub filter decoded image
  check_pixel(img, 0, 0, 0, 0, 0, 255)
  check_pixel(img, 5, 0, 253, 0, 219, 255)
  check_pixel(img, 5, 3, 253, 250, 26, 255)
  println("Real PNG RGB Sub filter test passed!")
}

