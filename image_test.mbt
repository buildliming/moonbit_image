//-----------------------------------------------------------------------------
// Test: PNG indexed color with PLTE palette (4x4)
//-----------------------------------------------------------------------------

fn make_real_png_indexed() -> Bytes {
  make_bytes([
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D, 0x49, 0x48, 0x44, 0x52,
    0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x04, 0x08, 0x03, 0x00, 0x00, 0x00, 0x9E, 0x2F, 0x6E,
    0x4C, 0x00, 0x00, 0x00, 0x0C, 0x50, 0x4C, 0x54, 0x45, 0xFF, 0x00, 0x00, 0x00, 0xFF, 0x00, 0x00,
    0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFB, 0x00, 0x60, 0xF6, 0x00, 0x00, 0x00, 0x14, 0x49, 0x44, 0x41,
    0x54, 0x78, 0x9C, 0x63, 0x60, 0x60, 0x64, 0x62, 0x06, 0x63, 0x06, 0x10, 0xCD, 0x00, 0x62, 0x03,
    0x00, 0x01, 0x04, 0x00, 0x19, 0x42, 0x7B, 0x91, 0x8C, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4E,
    0x44, 0xAE, 0x42, 0x60, 0x82
  ])
}

test "decode_real_png_indexed" {
  let img = decode_png(make_real_png_indexed())
  check_dims(img, 4, 4)
  // Indexed PNG should output RGBA8 after palette expansion
  match img.format {
    PixelFormat::RGBA8 => ()
    _ => raise Failure::Failure("Expected RGBA8 format from indexed PNG")
  }
  // Palette: {0: FF0000 (Red), 1: 00FF00 (Green), 2: 0000FF (Blue), 3: FFFFFF (White)}
  check_pixel(img, 0, 0, 255, 0, 0, 255)
  check_pixel(img, 1, 0, 0, 255, 0, 255)
  println("Real PNG indexed color test passed!")
}

