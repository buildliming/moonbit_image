    0x30, 0x08, 0x04, 0xC0, 0x47, 0x49, 0x45, 0x20, 0x20, 0x2A, 0x98, 0xD9, 0xB0, 0x81, 0x0E, 0x26,
    0x76, 0x4C, 0xC4, 0x00, 0x1E, 0x22, 0xE5, 0x7B, 0x27, 0x00, 0x14, 0x5F, 0xE0, 0x14, 0x7C, 0x91,
    0x44, 0x0B, 0xEC, 0x53, 0x3B, 0x61, 0x5E, 0x96, 0x6B, 0x4D, 0xBB, 0x82, 0x39, 0x3A, 0x1E, 0x93,
    0x35, 0xBD, 0x73, 0x39, 0x4F, 0x40, 0x57, 0x66, 0xB0, 0x8B, 0x77, 0xF9, 0x48, 0xFE, 0x09, 0xE3,
