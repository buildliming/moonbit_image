// Test: PNG grayscale+alpha 8-bit (4x4)
//-----------------------------------------------------------------------------

fn make_real_png_graya() -> Bytes {
  make_bytes([
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D, 0x49, 0x48, 0x44, 0x52,
    0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x04, 0x08, 0x04, 0x00, 0x00, 0x00, 0x03, 0xF8, 0x56,
    0xF5, 0x00, 0x00, 0x00, 0x20, 0x49, 0x44, 0x41, 0x54, 0x78, 0x9C, 0x0D, 0xC5, 0x31, 0x01, 0x00,
    0x00, 0x0C, 0x83, 0x30, 0x4C, 0xD6, 0x24, 0x26, 0xD9, 0xF2, 0x04, 0x18, 0x12, 0xFF, 0xE6, 0x1A,
    0x38, 0x35, 0xA1, 0x65, 0x75, 0xD5, 0xF8, 0x0F, 0xF1, 0x46, 0xF5, 0xF5, 0xAF, 0x00, 0x00, 0x00,
    0x00, 0x49, 0x45, 0x4E, 0x44, 0xAE, 0x42, 0x60, 0x82
