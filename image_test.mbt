test "decode_real_png_graya" {
  let img = decode_png(make_real_png_graya())
  check_dims(img, 4, 4)
  match img.format {
    PixelFormat::GrayA8 => ()
    _ => raise Failure::Failure("Expected GrayA8 format")
  }
  // (0,0): gray=0, alpha=0 → black, transparent
  check_pixel(img, 0, 0, 0, 0, 0, 0)
  // (3,3): gray=255, alpha=255 → white, opaque
  check_pixel(img, 3, 3, 255, 255, 255, 255)
  println("Real PNG grayscale+alpha test passed!")
}

// Adam7 interlaced PNG decoding is supported by the library but currently
// has a known issue with very small Adam7 images (8x8). Larger Adam7 images
// decode correctly. A future update will address edge cases in small images.

//=============================================================================
// Error Handling Tests - Comprehensive edge case coverage
// Each test uses try/catch: decode of bad data should raise Failure
//=============================================================================

test "error_empty_data" {
  // Empty data should raise Failure
  try {
    let _ = decode(Bytes::new(0))
    raise Failure::Failure("Expected failure for empty data")
  } catch {
    _ => ()
  }
  // Too-small data should not be detected
  let small = make_bytes([0x00, 0x00, 0x00, 0x00])
  match detect_format(small) {
    None => ()
    Some(_) => raise Failure::Failure("Small data should not match any format")
  }
  println("Error: empty/small data tests passed!")
}

test "error_invalid_magic" {
  // Invalid PNG signature (last byte corrupted)
  try {
    let _ = decode_png(make_bytes([
      0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0B,
      0x00, 0x00, 0x00, 0x0D, 0x49, 0x48, 0x44, 0x52,
      0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x02,
      0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    ]))
    raise Failure::Failure("Expected failure for bad PNG signature")
  } catch { _ => () }

  // Invalid QOI magic "qoig"
  try {
    let _ = decode_qoi(make_bytes([
      0x71, 0x6F, 0x69, 0x67, 0x00, 0x00, 0x00, 0x02,
      0x00, 0x00, 0x00, 0x02, 0x03, 0x00
    ]))
    raise Failure::Failure("Expected failure for bad QOI magic")
  } catch { _ => () }

  // Invalid BMP magic "BB"
  try {
    let _ = decode_bmp(make_bytes([
      0x42, 0x42, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00
    ]))
    raise Failure::Failure("Expected failure for bad BMP magic")
  } catch { _ => () }
  println("Error: invalid magic bytes tests passed!")
}

test "error_truncated_headers" {
  // BMP: too small for DIB header
  try {
    let _ = decode_bmp(make_bytes([
      0x42, 0x4D, 0x46, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x36, 0x00, 0x00, 0x00, 0x28, 0x00, 0x00, 0x00
    ]))
    raise Failure::Failure("Expected failure for truncated BMP")
  } catch { _ => () }

  // TGA: needs 18 bytes minimum
  try {
    let _ = decode_tga(make_bytes([0x00, 0x00, 0x02]))
    raise Failure::Failure("Expected failure for truncated TGA")
  } catch { _ => () }

  // QOI: needs at least 22 bytes
  try {
    let _ = decode_qoi(make_bytes([0x71, 0x6F, 0x69, 0x66]))
    raise Failure::Failure("Expected failure for truncated QOI")
  } catch { _ => () }

  // PNG: needs at least 8 bytes for signature
  try {
    let _ = decode_png(make_bytes([0x89, 0x50, 0x4E, 0x47]))
    raise Failure::Failure("Expected failure for truncated PNG")
  } catch { _ => () }
  println("Error: truncated headers tests passed!")
}

test "error_invalid_parameters" {
  // BMP: unsupported bit depth bpp=0
  try {
    let _ = decode_bmp(make_bytes([
      0x42, 0x4D, 0x46, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x36, 0x00, 0x00, 0x00, 0x28, 0x00, 0x00, 0x00,
      0x02, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00,
      0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00
    ]))
    raise Failure::Failure("Expected failure for BMP with bpp=0")
  } catch { _ => () }

  // TGA: unsupported image type=0
  try {
    let _ = decode_tga(make_bytes([
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x02, 0x00,
      0x18, 0x20
    ]))
    raise Failure::Failure("Expected failure for TGA with type=0")
  } catch { _ => () }

  // TGA: unsupported pixel depth=7
  try {
    let _ = decode_tga(make_bytes([
      0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x02, 0x00,
      0x07, 0x20
    ]))
    raise Failure::Failure("Expected failure for TGA with depth=7")
  } catch { _ => () }

  // BMP: zero dimensions
  try {
    let _ = decode_bmp(make_bytes([
      0x42, 0x4D, 0x46, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x36, 0x00, 0x00, 0x00, 0x28, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x01, 0x00, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00
    ]))
    raise Failure::Failure("Expected failure for BMP with zero dimensions")
  } catch { _ => () }

  // QOI: invalid channel count (5)
  try {
    let _ = decode_qoi(make_bytes([
      0x71, 0x6F, 0x69, 0x66, 0x00, 0x00, 0x00, 0x02,
      0x00, 0x00, 0x00, 0x02, 0x05, 0x00
    ]))
    raise Failure::Failure("Expected failure for QOI with 5 channels")
  } catch { _ => () }
  println("Error: invalid parameters tests passed!")
}

test "error_truncated_pixel_data" {
  // BMP: header OK but no pixel data follows
  try {
    let _ = decode_bmp(make_bytes([
      0x42, 0x4D, 0x46, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x36, 0x00, 0x00, 0x00, 0x28, 0x00, 0x00, 0x00,
      0x02, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00,
      0x01, 0x00, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x10, 0x00, 0x00, 0x00, 0x13, 0x0B, 0x00, 0x00,
      0x13, 0x0B, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00
    ]))
    raise Failure::Failure("Expected failure for truncated BMP pixel data")
  } catch { _ => () }

  // TGA: header OK but no pixel data
  try {
    let _ = decode_tga(make_bytes([
      0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x02, 0x00,
      0x18, 0x20
    ]))
    raise Failure::Failure("Expected failure for truncated TGA pixel data")
  } catch { _ => () }
  println("Error: truncated pixel data tests passed!")
}

test "error_invalid_png_structure" {
  // PNG: truncated before IHDR (only length field, no type/data)
  try {
    let _ = decode_png(make_bytes([
      0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A,
      0x00, 0x00, 0x00, 0x0D
    ]))
    raise Failure::Failure("Expected failure for PNG truncated before IHDR")
  } catch { _ => () }

  // PNG: IHDR present but no IDAT (only IHDR + IEND)
  try {
    let _ = decode_png(make_bytes([
      0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A,
      0x00, 0x00, 0x00, 0x0D, 0x49, 0x48, 0x44, 0x52,
      0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x02,
      0x08, 0x00, 0x00, 0x00, 0x00, 0x57, 0xDD, 0x52,
      0xF8,
      0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4E, 0x44,
      0xAE, 0x42, 0x60, 0x82
    ]))
    raise Failure::Failure("Expected failure for PNG with no IDAT")
  } catch { _ => () }
  println("Error: invalid PNG structure tests passed!")
}

test "error_tga_rle_overflow" {
  // TGA RLE: packet count (128) exceeds image pixel count (4)
  try {
    let _ = decode_tga(make_bytes([
      0x00, 0x00, 0x0A, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x02, 0x00,
      0x18, 0x20,
      0xFF, 0x00, 0x00, 0xFF
    ]))
    raise Failure::Failure("Expected failure for TGA RLE overflow")
  } catch { _ => () }
  println("Error: TGA RLE overflow test passed!")
}

test "error_unsupported_format" {
  // Bytes that don't match any format: invalid TGA image_type=0xFF, not BMP/QOI/PNG magic
  let junk = make_bytes([
    0x00, 0x00, 0xFF, 0x03, 0x04, 0x05, 0x06, 0x07,
    0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F,
    0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17
  ])
  if is_supported_format(junk) {
    raise Failure::Failure("Unrecognized bytes should not be detected as supported")
  }
  // Unified decode should also fail
  try {
    let _ = decode(junk)
    raise Failure::Failure("Expected failure for unrecognized bytes")
  } catch { _ => () }
  println("Error: unsupported format test passed!")
}

//=============================================================================
// GIF Tests
//=============================================================================

/// Minimal 2x2 GIF: red/blue checkerboard pattern (generated by PIL)
fn make_test_gif_2x2() -> Bytes {
  make_bytes([
    0x47, 0x49, 0x46, 0x38, 0x37, 0x61, 0x02, 0x00, 0x02, 0x00, 0x81, 0x00, 0x00, 0xFF, 0x00, 0x00,
    0x00, 0x00, 0xFF, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x2C, 0x00, 0x00, 0x00, 0x00, 0x02, 0x00,
    0x02, 0x00, 0x00, 0x08, 0x07, 0x00, 0x01, 0x04, 0x08, 0x00, 0x20, 0x20, 0x00, 0x3B,
  ])
}

test "decode_gif_2x2" {
  let img = decode_gif(make_test_gif_2x2())
  check_dims(img, 2, 2)
  match img.format {
    PixelFormat::RGBA8 => ()
    _ => raise Failure::Failure("Expected RGBA8 format for GIF")
  }
  // Row 0: Red, Blue
  check_pixel(img, 0, 0, 255, 0, 0, 255)
  check_pixel(img, 1, 0, 0, 0, 255, 255)
  // Row 1: Blue, Red
  check_pixel(img, 0, 1, 0, 0, 255, 255)
  check_pixel(img, 1, 1, 255, 0, 0, 255)
  println("GIF 2x2 test passed!")
}

test "detect_gif_format" {
  let gif_data = make_test_gif_2x2()
  match detect_format(gif_data) {
    Some(ImageFormat::GIF) => ()
    _ => raise Failure::Failure("Expected GIF format")
  }
  // Test unified decode
  let img = decode(gif_data)
  check_dims(img, 2, 2)
  println("GIF format detection test passed!")
}

test "gif_dimensions_fast" {
  let gif_data = make_test_gif_2x2()
  let (w, h, fmt) = image_dimensions(gif_data)
  if w != 2 || h != 2 { raise Failure::Failure("Expected 2x2, got \{w}x\{h}") }
  match fmt {
    ImageFormat::GIF => ()
    _ => raise Failure::Failure("Expected GIF format")
  }
  println("GIF dimensions test passed!")
}

// 8x8 GIF with grayscale checkerboard (2x2 blocks, generated by PIL)
fn make_test_gif_8x8() -> Bytes {
  make_bytes([
    0x47, 0x49, 0x46, 0x38, 0x37, 0x61, 0x08, 0x00, 0x08, 0x00, 0x81, 0x00, 0x00, 0xFF, 0xFF, 0xFF,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x2C, 0x00, 0x00, 0x00, 0x00, 0x08, 0x00,
    0x08, 0x00, 0x00, 0x08, 0x1B, 0x00, 0x01, 0x00, 0x08, 0x10, 0x40, 0x20, 0x41, 0x83, 0x05, 0x07,
    0x12, 0x4C, 0x78, 0x50, 0x21, 0x42, 0x81, 0x0F, 0x1D, 0x4A, 0x5C, 0xC8, 0xB0, 0x62, 0xC4, 0x80,
    0x00, 0x3B,
  ])
}

test "decode_gif_8x8" {
  let img = decode_gif(make_test_gif_8x8())
  check_dims(img, 8, 8)
  // Checkerboard: 2x2 blocks of black and white
  check_pixel(img, 0, 0, 255, 255, 255, 255)  // white block
  check_pixel(img, 2, 0, 0, 0, 0, 255)        // black block
  check_pixel(img, 0, 2, 0, 0, 0, 255)        // black block
  check_pixel(img, 2, 2, 255, 255, 255, 255)  // white block
  println("GIF 8x8 test passed!")
}

