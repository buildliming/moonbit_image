name = "shunge/image"

version = "0.2.1"

readme = "README.md"

repository = "https://github.com/buildliming/moonbit_image"

description = "纯 MoonBit 图像解码库，支持 BMP/QOI/TGA/PNG/GIF/JPEG 六种格式、渐进式 JPEG、Adam7 PNG 和 GIF 动画，内置 DEFLATE/LZW/RLE 解压及资源边界检查。"

keywords = [
  "image",
  "decoder",
  "png",
  "bmp",
  "qoi",
  "tga",
  "gif",
  "jpeg",
  "graphics",
]

license = "MIT"

options(
  authors: [ { "name": "lws", "email": "" } ],
)
