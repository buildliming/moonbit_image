    0x2D, 0xB4, 0x18, 0xAD, 0x96, 0x3B, 0x8F, 0x0F, 0xF9, 0x93, 0x79, 0x92, 0x3F,
    0x9A, 0xB7, 0xA4, 0x03, 0x1B, 0x2F, 0xEE, 0xD3, 0x6E, 0xDC, 0x02, 0xA7, 0x92,
    0x73, 0x93, 0xD3, 0x8E, 0xB5, 0x8B, 0xFD, 0x88, 0xBF, 0xF3, 0xEF, 0x1F, 0xFD,
    0xFC, 0x3F, 0xE1, 0x45, 0x14, 0x01, 0xFF, 0xD9,
  ])
}

///|
test "jpeg_real_photo_18" {
  let data = make_photo_18_thumb_jpeg()
  let img = decode_jpeg(data)
  if img.width != 25 || img.height != 56 {
    raise Failure::Failure(
      "jpeg_real_photo_18: expected 25x56, got \{img.width}x\{img.height}",
    )
  }
  let (sr, sg, sb) = jpeg_photo_checksum(img)
  if sr != 220863 || sg != 136573 || sb != 175509 {
    raise Failure::Failure(
      "jpeg_real_photo_18: checksum mismatch, expected (220863,136573,175509), got \{sr},\{sg},\{sb}",
    )
  }
  println("jpeg_real_photo_18 test passed!")
}
