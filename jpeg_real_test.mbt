///|
test "jpeg_real_photo_14" {
  let data = make_photo_14_thumb_jpeg()
  let img = decode_jpeg(data)
  if img.width != 56 || img.height != 41 {
    raise Failure::Failure(
      "jpeg_real_photo_14: expected 56x41, got \{img.width}x\{img.height}",
    )
  }
  let (sr, sg, sb) = jpeg_photo_checksum(img)
  if sr != 362163 || sg != 292095 || sb != 336260 {
    raise Failure::Failure(
      "jpeg_real_photo_14: checksum mismatch, expected (362163,292095,336260), got \{sr},\{sg},\{sb}",
    )
  }
  println("jpeg_real_photo_14 test passed!")
}

