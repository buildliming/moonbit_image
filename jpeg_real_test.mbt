///|
test "jpeg_real_photo_09" {
  let data = make_photo_09_thumb_jpeg()
  let img = decode_jpeg(data)
  if img.width != 25 || img.height != 56 {
    raise Failure::Failure(
      "jpeg_real_photo_09: expected 25x56, got \{img.width}x\{img.height}",
    )
  }
  let (sr, sg, sb) = jpeg_photo_checksum(img)
  if sr != 192815 || sg != 150222 || sb != 190371 {
    raise Failure::Failure(
      "jpeg_real_photo_09: checksum mismatch, expected (192815,150222,190371), got \{sr},\{sg},\{sb}",
    )
  }
  println("jpeg_real_photo_09 test passed!")
}

