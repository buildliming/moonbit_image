// Copyright (c) 2025 lws
// Real-world JPEG photo decoding tests
//
// Tests decode_jpeg() on embedded JPEG thumbnails of real photos.
// Checksums are verified against MoonBit decoder output (deterministic).
// Full-size originals in test_images/real_photo/photo_XX_original.jpg.

//-----------------------------------------------------------------------------
// Helper: pixel checksum
//-----------------------------------------------------------------------------

///|
fn jpeg_photo_checksum(img : Image) -> (Int, Int, Int) {
  let mut sr = 0
  let mut sg = 0
  let mut sb = 0
  for y = 0; y < img.height; y = y + 1 {
    for x = 0; x < img.width; x = x + 1 {
      let c = img.get_pixel(x, y)
      sr = sr + c.r
      sg = sg + c.g
      sb = sb + c.b
    }
  }
  (sr, sg, sb)
}

