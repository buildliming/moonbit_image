///|
test "jpeg_real_photo_08" {
  let data = make_photo_08_thumb_jpeg()
  let img = decode_jpeg(data)
  if img.width != 41 || img.height != 56 {
    raise Failure::Failure(
      "jpeg_real_photo_08: expected 41x56, got \{img.width}x\{img.height}",
    )
  }
  let (sr, sg, sb) = jpeg_photo_checksum(img)
  if sr != 336117 || sg != 277197 || sb != 340764 {
    raise Failure::Failure(
      "jpeg_real_photo_08: checksum mismatch, expected (336117,277197,340764), got \{sr},\{sg},\{sb}",
    )
  }
  println("jpeg_real_photo_08 test passed!")
}

