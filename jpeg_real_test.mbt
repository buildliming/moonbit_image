///|
test "jpeg_real_photo_16" {
  let data = make_photo_16_thumb_jpeg()
  let img = decode_jpeg(data)
  if img.width != 25 || img.height != 56 {
    raise Failure::Failure(
      "jpeg_real_photo_16: expected 25x56, got \{img.width}x\{img.height}",
    )
  }
  let (sr, sg, sb) = jpeg_photo_checksum(img)
  if sr != 204256 || sg != 166097 || sb != 200841 {
    raise Failure::Failure(
      "jpeg_real_photo_16: checksum mismatch, expected (204256,166097,200841), got \{sr},\{sg},\{sb}",
    )
  }
  println("jpeg_real_photo_16 test passed!")
}

