///|
test "jpeg_real_photo_12" {
  let data = make_photo_12_thumb_jpeg()
  let img = decode_jpeg(data)
  if img.width != 56 || img.height != 41 {
    raise Failure::Failure(
      "jpeg_real_photo_12: expected 56x41, got \{img.width}x\{img.height}",
    )
  }
  let (sr, sg, sb) = jpeg_photo_checksum(img)
  if sr != 343124 || sg != 310490 || sb != 403232 {
    raise Failure::Failure(
      "jpeg_real_photo_12: checksum mismatch, expected (343124,310490,403232), got \{sr},\{sg},\{sb}",
    )
  }
  println("jpeg_real_photo_12 test passed!")
}

