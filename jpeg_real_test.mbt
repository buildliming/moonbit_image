///|
test "jpeg_real_photo_13" {
  let data = make_photo_13_thumb_jpeg()
  let img = decode_jpeg(data)
  if img.width != 41 || img.height != 56 {
    raise Failure::Failure(
      "jpeg_real_photo_13: expected 41x56, got \{img.width}x\{img.height}",
    )
  }
  let (sr, sg, sb) = jpeg_photo_checksum(img)
  if sr != 340946 || sg != 287855 || sb != 327285 {
    raise Failure::Failure(
      "jpeg_real_photo_13: checksum mismatch, expected (340946,287855,327285), got \{sr},\{sg},\{sb}",
    )
  }
  println("jpeg_real_photo_13 test passed!")
}

