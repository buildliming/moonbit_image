///|
test "jpeg_real_photo_15" {
  let data = make_photo_15_thumb_jpeg()
  let img = decode_jpeg(data)
  if img.width != 25 || img.height != 56 {
    raise Failure::Failure(
      "jpeg_real_photo_15: expected 25x56, got \{img.width}x\{img.height}",
    )
  }
  let (sr, sg, sb) = jpeg_photo_checksum(img)
  if sr != 194722 || sg != 156889 || sb != 189060 {
    raise Failure::Failure(
      "jpeg_real_photo_15: checksum mismatch, expected (194722,156889,189060), got \{sr},\{sg},\{sb}",
    )
  }
  println("jpeg_real_photo_15 test passed!")
}

