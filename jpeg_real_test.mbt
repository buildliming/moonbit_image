///|
test "jpeg_real_photo_11" {
  let data = make_photo_11_thumb_jpeg()
  let img = decode_jpeg(data)
  if img.width != 56 || img.height != 41 {
    raise Failure::Failure(
      "jpeg_real_photo_11: expected 56x41, got \{img.width}x\{img.height}",
    )
  }
  let (sr, sg, sb) = jpeg_photo_checksum(img)
  if sr != 324288 || sg != 301040 || sb != 410301 {
    raise Failure::Failure(
      "jpeg_real_photo_11: checksum mismatch, expected (324288,301040,410301), got \{sr},\{sg},\{sb}",
    )
  }
  println("jpeg_real_photo_11 test passed!")
}

