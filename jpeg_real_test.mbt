///|
test "jpeg_real_photo_10" {
  let data = make_photo_10_thumb_jpeg()
  let img = decode_jpeg(data)
  if img.width != 41 || img.height != 56 {
    raise Failure::Failure(
      "jpeg_real_photo_10: expected 41x56, got \{img.width}x\{img.height}",
    )
  }
  let (sr, sg, sb) = jpeg_photo_checksum(img)
  if sr != 395820 || sg != 316962 || sb != 366395 {
    raise Failure::Failure(
      "jpeg_real_photo_10: checksum mismatch, expected (395820,316962,366395), got \{sr},\{sg},\{sb}",
    )
  }
  println("jpeg_real_photo_10 test passed!")
}

