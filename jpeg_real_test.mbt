///|
test "jpeg_real_photo_17" {
  let data = make_photo_17_thumb_jpeg()
  let img = decode_jpeg(data)
  if img.width != 56 || img.height != 41 {
    raise Failure::Failure(
      "jpeg_real_photo_17: expected 56x41, got \{img.width}x\{img.height}",
    )
  }
  let (sr, sg, sb) = jpeg_photo_checksum(img)
  if sr != 337015 || sg != 270034 || sb != 418523 {
    raise Failure::Failure(
      "jpeg_real_photo_17: checksum mismatch, expected (337015,270034,418523), got \{sr},\{sg},\{sb}",
    )
  }
  println("jpeg_real_photo_17 test passed!")
}

