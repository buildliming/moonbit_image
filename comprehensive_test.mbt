///|
test "decode_png_filter_up" {
  let data = make_png_filter_up()
  let img = decode_png(data)
  check_dims(img, 6, 4)
  match img.format {
    PixelFormat::RGB8 => ()
    _ => raise Failure::Failure("Bad fmt")
  }
  let (sr, sg, sb) = compute_checksum(img)
  if sr != 420 {
    raise Failure::Failure("sum_r \{sr} != 420")
  }
  if sg != 468 {
    raise Failure::Failure("sum_g \{sg} != 468")
  }
  if sb != 1056 {
    raise Failure::Failure("sum_b \{sb} != 1056")
  }
  println("PNG RGB8 (png_filter_up) test passed!")
}

///|
test "decode_png_filter_avg" {
  let data = make_png_filter_avg()
  let img = decode_png(data)
  check_dims(img, 6, 4)
  match img.format {
    PixelFormat::RGB8 => ()
    _ => raise Failure::Failure("Bad fmt")
  }
  let (sr, sg, sb) = compute_checksum(img)
  if sr != 420 {
    raise Failure::Failure("sum_r \{sr} != 420")
  }
  if sg != 468 {
    raise Failure::Failure("sum_g \{sg} != 468")
  }
  if sb != 1056 {
    raise Failure::Failure("sum_b \{sb} != 1056")
  }
  println("PNG RGB8 (png_filter_avg) test passed!")
}

///|
test "decode_png_mixed_filters" {
  let data = make_png_mixed_filters()
  let img = decode_png(data)
  check_dims(img, 6, 6)
  match img.format {
    PixelFormat::RGBA8 => ()
    _ => raise Failure::Failure("Bad fmt")
  }
  let (sr, sg, sb) = compute_checksum(img)
  if sr != 630 {
    raise Failure::Failure("sum_r \{sr} != 630")
  }
  if sg != 1170 {
    raise Failure::Failure("sum_g \{sg} != 1170")
  }
  if sb != 1980 {
    raise Failure::Failure("sum_b \{sb} != 1980")
  }
  println("PNG RGBA8 (png_mixed_filters) test passed!")
}

///|
test "decode_png_multi_idat" {
  let data = make_png_multi_idat()
  let img = decode_png(data)
  check_dims(img, 6, 4)
  match img.format {
    PixelFormat::RGB8 => ()
    _ => raise Failure::Failure("Bad fmt")
  }
  let (sr, sg, sb) = compute_checksum(img)
  if sr != 420 {
    raise Failure::Failure("sum_r \{sr} != 420")
  }
  if sg != 468 {
    raise Failure::Failure("sum_g \{sg} != 468")
  }
  if sb != 1056 {
    raise Failure::Failure("sum_b \{sb} != 1056")
  }
  println("PNG RGB8 (png_multi_idat) test passed!")
}

