///|
test "decode_gif_transparent_8x8" {
  let data = make_gif_transparent_8x8()
  let img = decode_gif(data)
  check_dims(img, 8, 8)
  match img.format {
    PixelFormat::RGBA8 => ()
    _ => raise Failure::Failure("Bad fmt")
  }
  if img.get_pixel(0, 0).a != 0 {
    raise Failure::Failure("Expected transparent at (0,0)")
  }
  if img.get_pixel(7, 7).a != 255 {
    raise Failure::Failure("Expected opaque at (7,7)")
  }
  println("GIF gif_transparent_8x8 test passed!")
}

