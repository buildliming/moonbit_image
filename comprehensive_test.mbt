///|
test "decode_gif_animated_6x6" {
  let anim = decode_gif_all(make_gif_animated_6x6())
  let nf = anim.frame_count()
  if nf != 2 {
    raise Failure::Failure("Expected 2 frames, got \{nf}")
  }
  if anim.width != 6 || anim.height != 6 {
    raise Failure::Failure("Bad canvas size")
  }
  if anim.loop_count != 0 {
    raise Failure::Failure("Expected loop_count=0")
  }
  match anim.frames[0].format {
    PixelFormat::RGBA8 => ()
    _ => raise Failure::Failure("Bad fmt")
  }
  if anim.delays[0] != 100 {
    raise Failure::Failure("Bad delay[0]: \{anim.delays[0]}")
  }
  if anim.delays[1] != 200 {
    raise Failure::Failure("Bad delay[1]: \{anim.delays[1]}")
  }
  println("GIF gif_animated_6x6 test passed!")
}

//=============================================================================
// Error Tests
//=============================================================================

///|
test "error_png_crc_mismatch" {
  let data_bytes = make_png_filter_up()
  let zero : Byte = b'\x00'
  let corrupted = Array::make(data_bytes.length(), zero)
  for i = 0; i < data_bytes.length(); i = i + 1 {
    corrupted[i] = data_bytes[i]
  }
  corrupted[32] = (corrupted[32].to_int() ^ 0xFF).to_byte()
  try {
    let _ = decode_png(Bytes::from_array(corrupted))
    raise Failure::Failure("Expected CRC failure")
  } catch {
    _ => ()
  }
  println("PNG CRC mismatch test passed!")
}

