///|
test "real_landscape_scene2_tga" {
  let image = @image.decode(make_real_landscape_scene2_tga())
  assert_eq(image.width, 48)
  assert_eq(image.height, 27)
  photo_reference_compare(
    image.to_rgba8().data,
    fixture_base64(
      (
        #|Cho2/wobN/8KGzf/Eh85/xIXMf8RFC//ERUt/xEVK/8QFS7/DxYx/xEVLf8SFir/ERUp/xIWKv8SFiv/ERUp/xAUKP8VGjH/GRsy/xITKf8SEyj/ERUq/xEV
