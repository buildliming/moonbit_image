///|
test "real_landscape_scene2_qoi" {
  let image = @image.decode(make_real_landscape_scene2_qoi())
  assert_eq(image.width, 48)
  assert_eq(image.height, 27)
  photo_reference_compare(
    image.to_rgba8().data,
    fixture_base64(
      (
