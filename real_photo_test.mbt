///|
test "real_texture_scene2_tga" {
  let image = @image.decode(make_real_texture_scene2_tga())
  assert_eq(image.width, 48)
  assert_eq(image.height, 27)
  photo_reference_compare(
    image.to_rgba8().data,
    fixture_base64(
      (
