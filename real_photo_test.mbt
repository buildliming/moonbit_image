///|
test "real_realistic_scene2_gif" {
  let image = @image.decode(make_real_realistic_scene2_gif())
  assert_eq(image.width, 48)
  assert_eq(image.height, 27)
  photo_reference_compare(
    image.to_rgba8().data,
    fixture_base64(
      (
        #|5ens/+rt8f/s7vL/8vL1/+3r7f/x4c//7tbB/+jUwv/p18j/7NnK/+zZyv/s2cr/6dfI/+rZyP/p18j/6NTC/+jUwv/o1ML/6dfI/+zZyv/q2cj/7NO6/+bM
