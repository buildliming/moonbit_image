// Medium-sized image tests (64x64) - Auto-generated by test_medium_images.py

// Expected checksums for 64x64 test pattern:
//   R=(x*7)%256, G=(y*13)%256, B=((x+y)*11)%256
//   sum_r=460800, sum_g=497664, sum_b=526080

// Helper: compute pixel checksum for verification

///|
fn compute_checksum(img : @image.Image) -> (Int, Int, Int) {
  let mut sum_r = 0
  let mut sum_g = 0
  let mut sum_b = 0
  for y = 0; y < img.height; y = y + 1 {
    for x = 0; x < img.width; x = x + 1 {
      let c = img.get_pixel(x, y)
      sum_r = sum_r + c.r
      sum_g = sum_g + c.g
      sum_b = sum_b + c.b
    }
  }
  (sum_r, sum_g, sum_b)
}

