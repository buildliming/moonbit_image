///|
test "medium_png_rgba_64_png" {
  let img = @image.decode_png(make_png_rgba_64_png())
  check_dims(img, 64, 64)
  match img.format {
    @image.PixelFormat::RGBA8 => ()
    _ => raise Failure::Failure("Expected RGBA8 format")
  }
  // Verify corner pixels
  check_pixel(img, 0, 0, 0, 0, 0, 255)
  check_pixel(img, 63, 0, 185, 0, 181, 255)
  check_pixel(img, 0, 63, 0, 51, 181, 255)
  check_pixel(img, 63, 63, 185, 51, 106, 255)
  check_pixel(img, 32, 32, 224, 160, 192, 255)
  // Full checksum verification (sum of all R,G,B values)
  let (sr, sg, sb) = compute_checksum(img)
  if sr != 460800 {
    raise Failure::Failure(
      "R-checksum mismatch: got " + sr.to_string() + ", expected 460800",
    )
  }
  if sg != 497664 {
    raise Failure::Failure(
      "G-checksum mismatch: got " + sg.to_string() + ", expected 497664",
    )
  }
  if sb != 526080 {
    raise Failure::Failure(
      "B-checksum mismatch: got " + sb.to_string() + ", expected 526080",
    )
  }
  println("Medium png_rgba_64x64.png test passed!")
}

