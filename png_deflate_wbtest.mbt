  expect_invalid_zlib(
    deflate_test_bytes([0x88, 0x1C, 0x03, 0x00, 0x00, 0x00, 0x00, 0x01]),
  )
}

///|
test "png_zlib_output_limit_stored_literals_and_matches" {
  expect_invalid_zlib(
    deflate_test_bytes([
      0x78, 0x01, 0x01, 0x03, 0x00, 0xFC, 0xFF, 0x41, 0x42, 0x43, 0x01, 0x8D, 0x00,
      0xC7,
    ]),
    max_output=2,
  )
  expect_invalid_zlib(
    deflate_test_bytes([
      0x78, 0x9C, 0x73, 0x74, 0x72, 0x06, 0x00, 0x01, 0x8D, 0x00, 0xC7,
    ]),
    max_output=2,
  )
  expect_invalid_zlib(
    deflate_test_bytes([
      0x78, 0x9C, 0x73, 0x74, 0x1C, 0x05, 0xA3, 0x60, 0x14, 0x8C, 0x54, 0x00, 0x00,
      0xA4, 0x78, 0x04, 0x10,
    ]),
    max_output=1023,
  )
  if zlib_decompress(
      deflate_test_bytes([
        0x78, 0x9C, 0x73, 0x74, 0x1C, 0x05, 0xA3, 0x60, 0x14, 0x8C, 0x54, 0x00, 0x00,
        0xA4, 0x78, 0x04, 0x10,
      ]),
      max_output=1024,
    ).length() !=
    1024 {
    raise Failure::Failure("Output limit rejected exact size")
  }
}

///|
test "png_zlib_trailer_follows_final_block" {
  if zlib_decompress(
      deflate_test_bytes([
        0x78, 0x9C, 0x73, 0x74, 0x72, 0x06, 0x00, 0x01, 0x8D, 0x00, 0xC7, 0x70, 0x61,
        0x64, 0x64, 0x69, 0x6E, 0x67,
      ]),
    ) !=
    deflate_test_bytes([0x41, 0x42, 0x43]) {
    raise Failure::Failure("Incorrect output with trailing IDAT padding")
  }
  expect_invalid_zlib(
    deflate_test_bytes([
      0x78, 0x9C, 0x73, 0x74, 0x72, 0x06, 0x00, 0x01, 0x8D, 0x00,
    ]),
  )
}
