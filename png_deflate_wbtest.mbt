test "png_deflate_reject_repeat_exceeds_code_lengths" {
  expect_invalid_deflate(
    deflate_test_bytes([
      0x05, 0xC0, 0x01, 0x09, 0x00, 0x00, 0x00, 0x80, 0xA0, 0xFF, 0xFF, 0x01,
    ]),
  )
}

