// Generated by tools/generate_png_deflate_fixtures.py.
// RFC bitstreams are independently checked with Python's zlib.

///|
fn deflate_test_bytes(values : Array[Int]) -> Bytes {
  Bytes::from_array(values.map(fn(value) { value.to_byte() }))
}

///|
fn deflate_test_decompress(data : Bytes) -> Bytes raise Failure {
  let (result, _) = deflate_decompress_stream(data, 0x7FFFFFFF, 32768)
  result
}

///|
fn expect_invalid_deflate(data : Bytes) -> Unit raise Failure {
  let rejected = try {
    let _ = deflate_test_decompress(data)
    false
  } catch {
    _ => true
  }
  if !rejected {
    raise Failure::Failure("DEFLATE accepted malformed stream")
  }
}

///|
fn expect_invalid_zlib(
  data : Bytes,
  max_output? : Int = 0x7FFFFFFF,
) -> Unit raise Failure {
  let rejected = try {
    let _ = zlib_decompress(data, max_output~)
    false
  } catch {
    _ => true
  }
  if !rejected {
    raise Failure::Failure(
      "zlib accepted malformed stream or exceeded output limit",
    )
  }
}

///|
test "png_deflate_fixed_blocks_keep_lookahead" {
  if deflate_test_decompress(deflate_test_bytes([0x72, 0x04, 0xCC, 0x09, 0x00])) !=
    deflate_test_bytes([0x41, 0x42]) {
    raise Failure::Failure("Incorrect DEFLATE output")
  }
  if zlib_decompress(
      deflate_test_bytes([
        0x78, 0x01, 0x72, 0x04, 0xCC, 0x09, 0x00, 0x00, 0xC6, 0x00, 0x84,
      ]),
    ) !=
    deflate_test_bytes([0x41, 0x42]) {
    raise Failure::Failure("Incorrect zlib output")
  }
}

///|
test "png_deflate_fixed_then_stored_block" {
  if deflate_test_decompress(
      deflate_test_bytes([0x72, 0x04, 0x04, 0x02, 0x00, 0xFD, 0xFF, 0x42, 0x43]),
    ) !=
    deflate_test_bytes([0x41, 0x42, 0x43]) {
    raise Failure::Failure("Incorrect DEFLATE output")
  }
  if zlib_decompress(
      deflate_test_bytes([
        0x78, 0x01, 0x72, 0x04, 0x04, 0x02, 0x00, 0xFD, 0xFF, 0x42, 0x43, 0x01, 0x8D,
        0x00, 0xC7,
      ]),
    ) !=
    deflate_test_bytes([0x41, 0x42, 0x43]) {
    raise Failure::Failure("Incorrect zlib output")
  }
}

///|
test "png_deflate_back_reference_crosses_blocks" {
  if deflate_test_decompress(
      deflate_test_bytes([0x72, 0x74, 0x02, 0x0C, 0x0A, 0x01]),
    ) !=
    deflate_test_bytes([0x41, 0x42, 0x41, 0x42, 0x41, 0x42, 0x41, 0x42, 0x41]) {
    raise Failure::Failure("Incorrect DEFLATE output")
  }
  if zlib_decompress(
      deflate_test_bytes([
        0x78, 0x01, 0x72, 0x74, 0x02, 0x0C, 0x0A, 0x01, 0x0B, 0x8A, 0x02, 0x4E,
      ]),
    ) !=
    deflate_test_bytes([0x41, 0x42, 0x41, 0x42, 0x41, 0x42, 0x41, 0x42, 0x41]) {
    raise Failure::Failure("Incorrect zlib output")
  }
}

///|
test "png_deflate_fixed_then_dynamic_block" {
  if deflate_test_decompress(
      deflate_test_bytes([
        0x72, 0x02, 0x14, 0x00, 0x07, 0x24, 0x00, 0x00, 0x00, 0x00, 0x82, 0xB6, 0xF9,
        0xFF, 0x94, 0x08,
      ]),
    ) !=
    deflate_test_bytes([0x42, 0x41]) {
    raise Failure::Failure("Incorrect DEFLATE output")
  }
  if zlib_decompress(
      deflate_test_bytes([
        0x78, 0x01, 0x72, 0x02, 0x14, 0x00, 0x07, 0x24, 0x00, 0x00, 0x00, 0x00, 0x82,
        0xB6, 0xF9, 0xFF, 0x94, 0x08, 0x00, 0xC7, 0x00, 0x84,
      ]),
    ) !=
    deflate_test_bytes([0x42, 0x41]) {
    raise Failure::Failure("Incorrect zlib output")
  }
}

