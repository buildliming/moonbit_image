///|
test "png_deflate_reject_empty_code_tree" {
  expect_invalid_deflate(deflate_test_bytes([0x05, 0x00, 0x00, 0x00]))
}

///|
test "png_deflate_reject_oversubscribed_code_tree" {
  expect_invalid_deflate(deflate_test_bytes([0x05, 0x00, 0x92, 0x00]))
}

///|
test "png_deflate_reject_incomplete_code_tree" {
  expect_invalid_deflate(deflate_test_bytes([0x05, 0x00, 0x04, 0x00]))
}

///|
test "png_deflate_reject_repeat_without_previous" {
  expect_invalid_deflate(deflate_test_bytes([0x05, 0x00, 0x02, 0x24]))
}

