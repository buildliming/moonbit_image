test "png_pixels_gray1_plain" {
  let data = png_pixels_bytes([
    137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 9, 0,
    0, 0, 5, 1, 0, 0, 0, 0, 191, 40, 251, 198, 0, 0, 0, 23, 73, 68, 65, 84, 120,
    156, 99, 88, 245, 159, 113, 85, 40, 19, 3, 3, 115, 168, 54, 11, 3, 3, 0, 35,
    127, 3, 51, 254, 222, 141, 202, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130,
  ])
  let expected = png_pixels_bytes([
    255, 0, 255, 0, 255, 0, 255, 0, 255, 255, 0, 255, 0, 255, 0, 255, 0, 255, 255,
    0, 255, 0, 255, 0, 255, 0, 255, 255, 0, 255, 0, 255, 0, 255, 0, 255, 255, 0,
    255, 0, 255, 0, 255, 0, 255,
  ])
  png_pixels_check(data, 9, 5, "Gray8", expected)
}

