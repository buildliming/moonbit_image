// Regenerate: python tools/generate_png_regression_fixtures.py, then moon fmt.
// PNG construction uses Python stdlib, and expected pixels come from unpacked samples.

///|
fn png_pixels_bytes(values : Array[Int]) -> Bytes {
  Bytes::from_array(values.map(value => value.to_byte()))
}

///|
fn png_pixels_check(
  data : Bytes,
  width : Int,
  height : Int,
  format : String,
  expected : Bytes,
) -> Unit raise Failure {
  let image = @image.decode_png(data)
  if image.width != width || image.height != height {
    raise Failure::Failure(
      "PNG dimensions: expected \{width}x\{height}, got \{image.width}x\{image.height}",
    )
  }
  let actual_format = @image.pixel_format_name(image.format)
  if actual_format != format {
    raise Failure::Failure(
      "PNG format: expected \{format}, got \{actual_format}",
    )
  }
  if image.data.length() != expected.length() {
    raise Failure::Failure(
      "PNG byte count: expected \{expected.length()}, got \{image.data.length()}",
    )
  }
  for index = 0; index < expected.length(); index = index + 1 {
    if image.data[index] != expected[index] {
      raise Failure::Failure(
        "PNG byte \{index}: expected \{expected[index].to_int()}, got \{image.data[index].to_int()}",
      )
    }
  }
}

