test "complex_png_mandelbrot_128" {
  let img = @image.decode_png(make_png_mandelbrot_128())
  check_dims(img, 128, 128)
  match img.format {
    @image.PixelFormat::RGB8 => ()
    _ => raise Failure::Failure("Expected RGB8 format")
  }
  check_pixel(img, 0, 0, 4, 12, 28, 255)
  check_pixel(img, 127, 0, 4, 12, 28, 255)
  check_pixel(img, 0, 127, 4, 12, 28, 255)
  check_pixel(img, 127, 127, 4, 12, 28, 255)
  check_pixel(img, 64, 64, 0, 0, 0, 255)
  let (sr, sg, sb) = complex_checksum(img)
  if sr != 196508 {
    raise Failure::Failure(
      "R-checksum mismatch: got " + sr.to_string() + ", expected 196508",
    )
  }
  if sg != 530388 {
    raise Failure::Failure(
      "G-checksum mismatch: got " + sg.to_string() + ", expected 530388",
    )
  }
  if sb != 1087300 {
    raise Failure::Failure(
      "B-checksum mismatch: got " + sb.to_string() + ", expected 1087300",
    )
  }
  println("Complex png_mandelbrot_128 test passed!")
}

