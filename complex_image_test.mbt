///|
test "complex_tga_checkerboard_128" {
  let img = @image.decode_tga(make_tga_checkerboard_128())
  check_dims(img, 128, 128)
  match img.format {
    @image.PixelFormat::RGBA8 => ()
    _ => raise Failure::Failure("Expected RGBA8 format")
  }
  check_pixel(img, 0, 0, 255, 255, 255, 255)
  check_pixel(img, 127, 0, 0, 0, 0, 255)
  check_pixel(img, 0, 127, 0, 0, 0, 255)
  check_pixel(img, 127, 127, 255, 255, 255, 255)
  check_pixel(img, 64, 64, 255, 255, 255, 255)
  let (sr, sg, sb) = complex_checksum(img)
  if sr != 2088960 {
    raise Failure::Failure(
      "R-checksum mismatch: got " + sr.to_string() + ", expected 2088960",
    )
  }
  if sg != 2088960 {
    raise Failure::Failure(
      "G-checksum mismatch: got " + sg.to_string() + ", expected 2088960",
    )
  }
  if sb != 2088960 {
    raise Failure::Failure(
      "B-checksum mismatch: got " + sb.to_string() + ", expected 2088960",
    )
  }
  println("Complex tga_checkerboard_128 test passed!")
}

// checkerboard pattern, QOI format (64.0 KB)

///|
fn make_qoi_checkerboard_128() -> Bytes {
  fixture_base64(
    (
      #|cW9pZgAAAIAAAACAAwD+/////v////7////+/////v//AP7//wD+//8A/v//AP4A///+AP///gD///4A///+AP8A/gD/AP4A/wD+AP8A/v8A//7/AP/+/wD/
      #|/v8A//7/AAD+/wAA/v8AAP7/AAD+AAD//gAA//4AAP/+AAD//gAAAP4AAAD+AAAA/gAAAP7////+/////v////7////+//8A/v//AP7//wD+//8A/gD///4A
      #|///+AP///gD///4A/wD+AP8A/gD/AP4A/wD+/wD//v8A//7/AP/+/wD//v8AAP7/AAD+/wAA/v8AAP4AAP/+AAD//gAA//4AAP/+AAAA/gAAAP4AAAD+AAAA
      #|/v////7////+/////v////7//wD+//8A/v//AP7//wD+AP///gD///4A///+AP///gD/AP4A/wD+AP8A/gD/AP7/AP/+/wD//v8A//7/AP/+/wAA/v8AAP7/
      #|AAD+/wAA/gAA//4AAP/+AAD//gAA//4AAAD+AAAA/gAAAP4AAAD+/////v////7////+/////v//AP7//wD+//8A/v//AP4A///+AP///gD///4A///+AP8A
      #|/gD/AP4A/wD+AP8A/v8A//7/AP/+/wD//v8A//7/AAD+/wAA/v8AAP7/AAD+AAD//gAA//4AAP/+AAD//gAAAP4AAAD+AAAA/gAAAP7////+/////v////7/
      #|///+//8A/v//AP7//wD+//8A/gD///4A///+AP///gD///4A/wD+AP8A/gD/AP4A/wD+/wD//v8A//7/AP/+/wD//v8AAP7/AAD+/wAA/v8AAP4AAP/+AAD/
      #|/gAA//4AAP/+AAAA/gAAAP4AAAD+AAAA/v////7////+/////v////7//wD+//8A/v//AP7//wD+AP///gD///4A///+AP///gD/AP4A/wD+AP8A/gD/AP7/
      #|AP/+/wD//v8A//7/AP/+/wAA/v8AAP7/AAD+/wAA/gAA//4AAP/+AAD//gAA//4AAAD+AAAA/gAAAP4AAAD+/////v////7////+/////v//AP7//wD+//8A
      #|/v//AP4A///+AP///gD///4A///+AP8A/gD/AP4A/wD+AP8A/v8A//7/AP/+/wD//v8A//7/AAD+/wAA/v8AAP7/AAD+AAD//gAA//4AAP/+AAD//gAAAP4A
      #|AAD+AAAA/gAAAP7////+/////v////7////+//8A/v//AP7//wD+//8A/gD///4A///+AP///gD///4A/wD+AP8A/gD/AP4A/wD+/wD//v8A//7/AP/+/wD/
      #|/v8AAP7/AAD+/wAA/v8AAP4AAP/+AAD//gAA//4AAP/+AAAA/gAAAP4AAAD+AAAA/v////7////+/////v////7//wD+//8A/v//AP7//wD+AP///gD///4A
