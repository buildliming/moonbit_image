///|
test "complex_bmp_noise_128" {
  let img = @image.decode_bmp(make_bmp_noise_128())
  check_dims(img, 128, 128)
  match img.format {
    @image.PixelFormat::RGB8 => ()
    _ => raise Failure::Failure("Expected RGB8 format")
  }
  check_pixel(img, 0, 0, 0, 0, 0, 255)
  check_pixel(img, 127, 0, 23, 236, 71, 255)
  check_pixel(img, 0, 127, 131, 143, 206, 255)
  check_pixel(img, 127, 127, 214, 188, 28, 255)
  check_pixel(img, 64, 64, 190, 202, 192, 255)
  let (sr, sg, sb) = complex_checksum(img)
  if sr != 2039465 {
    raise Failure::Failure(
      "R-checksum mismatch: got " + sr.to_string() + ", expected 2039465",
    )
  }
  if sg != 2079301 {
    raise Failure::Failure(
      "G-checksum mismatch: got " + sg.to_string() + ", expected 2079301",
    )
  }
  if sb != 2083584 {
    raise Failure::Failure(
      "B-checksum mismatch: got " + sb.to_string() + ", expected 2083584",
    )
  }
  println("Complex bmp_noise_128 test passed!")
}

