///|
test "complex_qoi_radial_128" {
  let img = @image.decode_qoi(make_qoi_radial_128())
  check_dims(img, 128, 128)
  match img.format {
    @image.PixelFormat::RGBA8 => ()
    _ => raise Failure::Failure("Expected RGBA8 format")
  }
  check_pixel(img, 0, 0, 255, 0, 128, 255)
  check_pixel(img, 127, 0, 255, 0, 128, 255)
  check_pixel(img, 0, 127, 255, 0, 128, 255)
  check_pixel(img, 127, 127, 255, 0, 128, 255)
  check_pixel(img, 64, 64, 0, 255, 128, 255)
  let (sr, sg, sb) = complex_checksum(img)
  if sr != 3077689 {
    raise Failure::Failure(
      "R-checksum mismatch: got " + sr.to_string() + ", expected 3077689",
    )
  }
  if sg != 1087383 {
    raise Failure::Failure(
      "G-checksum mismatch: got " + sg.to_string() + ", expected 1087383",
    )
  }
  if sb != 3131004 {
    raise Failure::Failure(
      "B-checksum mismatch: got " + sb.to_string() + ", expected 3131004",
    )
  }
  println("Complex qoi_radial_128 test passed!")
}

