// Complex image tests (128x128) - Auto-generated

///|
fn complex_checksum(img : @image.Image) -> (Int, Int, Int) {
  let mut sr = 0
  let mut sg = 0
  let mut sb = 0
  for y = 0; y < img.height; y = y + 1 {
    for x = 0; x < img.width; x = x + 1 {
      let c = img.get_pixel(x, y)
      sr = sr + c.r
      sg = sg + c.g
      sb = sb + c.b
    }
  }
  (sr, sg, sb)
}

