///|
test "complex_png_checkerboard_128" {
  let img = @image.decode_png(make_png_checkerboard_128())
  check_dims(img, 128, 128)
  match img.format {
    @image.PixelFormat::RGB8 => ()
    _ => raise Failure::Failure("Expected RGB8 format")
  }
  check_pixel(img, 0, 0, 255, 255, 255, 255)
  check_pixel(img, 127, 0, 0, 0, 0, 255)
  check_pixel(img, 0, 127, 0, 0, 0, 255)
  check_pixel(img, 127, 127, 255, 255, 255, 255)
  check_pixel(img, 64, 64, 255, 255, 255, 255)
  let (sr, sg, sb) = complex_checksum(img)
  if sr != 2088960 {
    raise Failure::Failure(
      "R-checksum mismatch: got " + sr.to_string() + ", expected 2088960",
    )
  }
  if sg != 2088960 {
    raise Failure::Failure(
      "G-checksum mismatch: got " + sg.to_string() + ", expected 2088960",
    )
  }
  if sb != 2088960 {
    raise Failure::Failure(
      "B-checksum mismatch: got " + sb.to_string() + ", expected 2088960",
    )
  }
  println("Complex png_checkerboard_128 test passed!")
}

