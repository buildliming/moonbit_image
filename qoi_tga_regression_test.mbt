///|
test "stability_tga_reject_truecolor8" {
  let rejected = try {
    let _ = @image.decode_tga(
      b"\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x01\x00\x08\x20\x00\x00\x00\x00",
    )
    false
  } catch {
    _ => true
  }
  assert_true(rejected)
}

