  stability_pixels(
    b"\x00\x00\x0A\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x01\x00\x10\x20\x81\x00\x7C",
    2, 1, b"\xFF\x00\x00\xFF\xFF\x00\x00\xFF",
  )
}

