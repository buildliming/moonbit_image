// Regenerate: python tools/generate_gif_regression_fixtures.py, then moon fmt.
// Expected RGBA pixels and metadata are independently decoded by Pillow.

///|
fn gif_regression_bytes(values : Array[Int]) -> Bytes {
  Bytes::from_array(values.map(value => value.to_byte()))
}

///|
fn gif_regression_check(
  image : @image.Image,
  width : Int,
  height : Int,
  expected : Bytes,
) -> Unit raise Failure {
  if image.width != width ||
    image.height != height ||
    @image.pixel_format_name(image.format) != "RGBA8" {
    raise Failure::Failure("GIF image dimensions or format mismatch")
  }
  if image.data.length() != expected.length() {
    raise Failure::Failure("GIF byte count mismatch")
  }
  for i = 0; i < expected.length(); i = i + 1 {
    if image.data[i] != expected[i] {
      raise Failure::Failure(
        "GIF byte \{i}: expected \{expected[i].to_int()}, got \{image.data[i].to_int()}",
      )
    }
  }
}

///|
fn gif_regression_reject(
  data : Bytes,
  all_only? : Bool = false,
) -> Unit raise Failure {
  if !all_only {
    let rejected = try {
      let _ = @image.decode_gif(data)
      false
    } catch {
      _ => true
    }
    if !rejected {
      raise Failure::Failure("GIF first-frame decoder accepted malformed input")
    }
  }
  let rejected = try {
    let _ = @image.decode_gif_all(data)
    false
  } catch {
    _ => true
  }
  if !rejected {
    raise Failure::Failure("GIF animation decoder accepted malformed input")
  }
}

///|
test "gif_regression_offset_first_frame" {
  let data = gif_regression_bytes([
    71, 73, 70, 56, 57, 97, 4, 0, 3, 0, 129, 0, 0, 13, 29, 41, 223, 17, 31, 19, 211,
    47, 23, 37, 229, 44, 1, 0, 1, 0, 2, 0, 1, 0, 0, 2, 2, 12, 85, 0, 59,
  ])
  let animation = @image.decode_gif_all(data)
  if animation.width != 4 ||
    animation.height != 3 ||
    animation.frames.length() != 1 ||
    animation.loop_count != 0 {
    raise Failure::Failure("GIF animation metadata mismatch")
  }
  let expected = gif_regression_bytes([
    13, 29, 41, 255, 13, 29, 41, 255, 13, 29, 41, 255, 13, 29, 41, 255, 13, 29, 41,
    255, 223, 17, 31, 255, 19, 211, 47, 255, 13, 29, 41, 255, 13, 29, 41, 255, 13,
    29, 41, 255, 13, 29, 41, 255, 13, 29, 41, 255,
  ])
  gif_regression_check(animation.frames[0], 4, 3, expected)
  if animation.delays[0] != 0 {
    raise Failure::Failure("GIF delay mismatch in frame 0")
  }
  gif_regression_check(@image.decode_gif(data), 4, 3, expected)
}

///|
test "gif_regression_local_palette_offset" {
  let data = gif_regression_bytes([
    71, 73, 70, 56, 57, 97, 4, 0, 3, 0, 129, 0, 0, 13, 29, 41, 223, 17, 31, 19, 211,
    47, 23, 37, 229, 44, 1, 0, 1, 0, 2, 0, 1, 0, 128, 13, 29, 41, 73, 149, 229, 2,
    2, 4, 83, 0, 59,
  ])
  let animation = @image.decode_gif_all(data)
  if animation.width != 4 ||
    animation.height != 3 ||
    animation.frames.length() != 1 ||
    animation.loop_count != 0 {
    raise Failure::Failure("GIF animation metadata mismatch")
  }
  let expected = gif_regression_bytes([
    13, 29, 41, 255, 13, 29, 41, 255, 13, 29, 41, 255, 13, 29, 41, 255, 13, 29, 41,
    255, 13, 29, 41, 255, 73, 149, 229, 255, 13, 29, 41, 255, 13, 29, 41, 255, 13,
    29, 41, 255, 13, 29, 41, 255, 13, 29, 41, 255,
  ])
  gif_regression_check(animation.frames[0], 4, 3, expected)
  if animation.delays[0] != 0 {
    raise Failure::Failure("GIF delay mismatch in frame 0")
  }
  gif_regression_check(@image.decode_gif(data), 4, 3, expected)
}

///|
test "gif_regression_transparent_offset" {
  let data = gif_regression_bytes([
    71, 73, 70, 56, 57, 97, 4, 0, 3, 0, 129, 0, 0, 13, 29, 41, 223, 17, 31, 19, 211,
    47, 23, 37, 229, 33, 249, 4, 1, 0, 0, 0, 0, 44, 1, 0, 1, 0, 2, 0, 1, 0, 0, 2,
    2, 12, 81, 0, 59,
  ])
  let animation = @image.decode_gif_all(data)
  if animation.width != 4 ||
    animation.height != 3 ||
    animation.frames.length() != 1 ||
    animation.loop_count != 0 {
    raise Failure::Failure("GIF animation metadata mismatch")
  }
  let expected = gif_regression_bytes([
    13, 29, 41, 0, 13, 29, 41, 0, 13, 29, 41, 0, 13, 29, 41, 0, 13, 29, 41, 0, 223,
    17, 31, 255, 13, 29, 41, 0, 13, 29, 41, 0, 13, 29, 41, 0, 13, 29, 41, 0, 13,
    29, 41, 0, 13, 29, 41, 0,
  ])
  gif_regression_check(animation.frames[0], 4, 3, expected)
  if animation.delays[0] != 0 {
    raise Failure::Failure("GIF delay mismatch in frame 0")
  }
  gif_regression_check(@image.decode_gif(data), 4, 3, expected)
}

///|
test "gif_regression_repeated_clear_codes" {
  let data = gif_regression_bytes([
    71, 73, 70, 56, 57, 97, 2, 0, 1, 0, 129, 0, 0, 13, 29, 41, 223, 17, 31, 19, 211,
    47, 23, 37, 229, 44, 0, 0, 0, 0, 2, 0, 1, 0, 0, 2, 3, 36, 200, 20, 0, 59,
  ])
  let animation = @image.decode_gif_all(data)
  if animation.width != 2 ||
    animation.height != 1 ||
    animation.frames.length() != 1 ||
    animation.loop_count != 0 {
    raise Failure::Failure("GIF animation metadata mismatch")
  }
  let expected = gif_regression_bytes([13, 29, 41, 255, 223, 17, 31, 255])
  gif_regression_check(animation.frames[0], 2, 1, expected)
  if animation.delays[0] != 0 {
    raise Failure::Failure("GIF delay mismatch in frame 0")
  }
  gif_regression_check(@image.decode_gif(data), 2, 1, expected)
}

///|
test "gif_regression_nonzero_lzw_bit_padding" {
  let data = gif_regression_bytes([
    71, 73, 70, 56, 57, 97, 1, 0, 1, 0, 129, 0, 0, 13, 29, 41, 223, 17, 31, 19, 211,
    47, 23, 37, 229, 44, 0, 0, 0, 0, 1, 0, 1, 0, 0, 2, 2, 76, 255, 0, 59,
  ])
  let animation = @image.decode_gif_all(data)
  if animation.width != 1 ||
    animation.height != 1 ||
    animation.frames.length() != 1 ||
    animation.loop_count != 0 {
    raise Failure::Failure("GIF animation metadata mismatch")
  }
  let expected = gif_regression_bytes([223, 17, 31, 255])
  gif_regression_check(animation.frames[0], 1, 1, expected)
  if animation.delays[0] != 0 {
    raise Failure::Failure("GIF delay mismatch in frame 0")
  }
  gif_regression_check(@image.decode_gif(data), 1, 1, expected)
}

///|
test "gif_regression_kwkwk_code_size_growth" {
  let data = gif_regression_bytes([
    71, 73, 70, 56, 57, 97, 6, 0, 1, 0, 129, 0, 0, 13, 29, 41, 223, 17, 31, 19, 211,
    47, 23, 37, 229, 44, 0, 0, 0, 0, 6, 0, 1, 0, 0, 2, 2, 132, 95, 0, 59,
  ])
  let animation = @image.decode_gif_all(data)
  if animation.width != 6 ||
    animation.height != 1 ||
    animation.frames.length() != 1 ||
    animation.loop_count != 0 {
    raise Failure::Failure("GIF animation metadata mismatch")
  }
  let expected = gif_regression_bytes([
    13, 29, 41, 255, 13, 29, 41, 255, 13, 29, 41, 255, 13, 29, 41, 255, 13, 29, 41,
    255, 13, 29, 41, 255,
  ])
  gif_regression_check(animation.frames[0], 6, 1, expected)
  if animation.delays[0] != 0 {
    raise Failure::Failure("GIF delay mismatch in frame 0")
  }
  gif_regression_check(@image.decode_gif(data), 6, 1, expected)
}

