test "gif_regression_subblock_byte_boundaries" {
  let data = gif_regression_bytes([
    71, 73, 70, 56, 57, 97, 11, 0, 3, 0, 129, 0, 0, 13, 29, 41, 223, 17, 31, 19,
    211, 47, 23, 37, 229, 44, 0, 0, 0, 0, 11, 0, 3, 0, 0, 2, 1, 4, 1, 67, 1, 113,
    1, 4, 1, 67, 1, 113, 1, 4, 1, 67, 1, 113, 1, 4, 1, 67, 1, 113, 1, 4, 1, 67, 1,
    113, 1, 4, 1, 67, 1, 113, 1, 4, 1, 67, 1, 113, 1, 4, 1, 67, 1, 113, 1, 68, 1,
    1, 0, 59,
  ])
  let animation = @image.decode_gif_all(data)
  if animation.width != 11 ||
    animation.height != 3 ||
    animation.frames.length() != 1 ||
    animation.loop_count != 0 {
    raise Failure::Failure("GIF animation metadata mismatch")
  }
  let expected = gif_regression_bytes([
    13, 29, 41, 255, 223, 17, 31, 255, 19, 211, 47, 255, 23, 37, 229, 255, 13, 29,
    41, 255, 223, 17, 31, 255, 19, 211, 47, 255, 23, 37, 229, 255, 13, 29, 41, 255,
    223, 17, 31, 255, 19, 211, 47, 255, 23, 37, 229, 255, 13, 29, 41, 255, 223, 17,
    31, 255, 19, 211, 47, 255, 23, 37, 229, 255, 13, 29, 41, 255, 223, 17, 31, 255,
    19, 211, 47, 255, 23, 37, 229, 255, 13, 29, 41, 255, 223, 17, 31, 255, 19, 211,
    47, 255, 23, 37, 229, 255, 13, 29, 41, 255, 223, 17, 31, 255, 19, 211, 47, 255,
    23, 37, 229, 255, 13, 29, 41, 255, 223, 17, 31, 255, 19, 211, 47, 255, 23, 37,
    229, 255, 13, 29, 41, 255,
  ])
  gif_regression_check(animation.frames[0], 11, 3, expected)
  if animation.delays[0] != 0 {
    raise Failure::Failure("GIF delay mismatch in frame 0")
  }
  gif_regression_check(@image.decode_gif(data), 11, 3, expected)
}

