// GIF89a background rule; Pillow differs for partial first frames.

///|
test "gif_regression_logical_background_index" {
  let data = gif_regression_bytes([
    71, 73, 70, 56, 57, 97, 3, 0, 1, 0, 129, 2, 0, 13, 29, 41, 223, 17, 31, 19, 211,
    47, 23, 37, 229, 44, 1, 0, 0, 0, 1, 0, 1, 0, 0, 2, 2, 92, 1, 0, 59,
  ])
  let animation = @image.decode_gif_all(data)
  if animation.width != 3 ||
    animation.height != 1 ||
    animation.frames.length() != 1 ||
    animation.loop_count != 0 {
    raise Failure::Failure("GIF animation metadata mismatch")
  }
  let expected = gif_regression_bytes([
    19, 211, 47, 255, 23, 37, 229, 255, 19, 211, 47, 255,
  ])
  gif_regression_check(animation.frames[0], 3, 1, expected)
  if animation.delays[0] != 0 {
    raise Failure::Failure("GIF delay mismatch in frame 0")
  }
  gif_regression_check(@image.decode_gif(data), 3, 1, expected)
}

