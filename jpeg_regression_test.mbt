  for y = 0; y < 9; y = y + 1 {
    for x = 0; x < 4; x = x + 1 {
      let pixel = image.get_pixel(x, y)
      let offset = (y * 4 + x) * 3
      let actual = [pixel.r, pixel.g, pixel.b]
      for channel = 0; channel < 3; channel = channel + 1 {
        let difference = actual[channel] - expected[offset + channel].to_int()
